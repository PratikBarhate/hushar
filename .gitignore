####################

# Visual Studio Code
.vscode/

# IntelliJ Rust / CLion
.idea/
*.iml

# Vim
*.swp
*.swo
*.swn
.*.swp

# Emacs
*#*#
.#*

# Logs, temporary and backup files #
####################################
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*~

