name: "bench_vectorized"
platform: "tensorrt_plan"
max_batch_size: 0

input [
  {
    name: "features"
    data_type: TYPE_FP32
    dims: [-1, 690]
  }
]

output [
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [-1, 5]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [0]
  }
]

